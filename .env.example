# GitHub Configuration
# Create a fine-grained token with Contents: Read and write access to the repository below.
GITHUB_TOKEN=replace_with_your_github_token
GITHUB_OWNER=your-github-username-or-organization
GITHUB_REPOSITORY=your-threads-repository
GITHUB_BRANCH=main

# Thread Configuration
THREAD_BASE_PATH=users

# Limits
MAX_MESSAGES=100
MAX_TOKENS=50000
MAX_FILE_SIZE_MB=5

# Logging
LOG_LEVEL=INFO
